<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>知识库目录</title>
<style>
  /* ── 深色胡桃木 × 米黄宣纸（与管理端同一套令牌）── */
  :root {
    --wood-bg: #211810;
    --wood-panel: #2b1f12;
    --wood-line: #4e3a1d;
    --wood-dark: #170f08;
    --paper: #f2e9cf;
    --paper-2: #ebdfba;
    --paper-line: #c6b288;
    --paper-hair: #ddd0aa;
    --brass: #b8912f;
    --brass-dark: #8f6f1f;
    --seal: #8e3524;
    --pine: #44553f;
    --amber: #96662a;
    --cream: #e9dcb6;
    --cream-dim: #a3905f;
    --ink: #2b2114;
    --ink-dim: #77653f;
    --serif: Georgia, "Times New Roman", "STSong", "SimSun", serif;
    --mono: "Courier New", Consolas, monospace;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  body {
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    color: var(--cream); min-height: 100vh;
    background:
      repeating-linear-gradient(93deg, rgba(0,0,0,.13) 0 2px, transparent 2px 8px),
      repeating-linear-gradient(87deg, rgba(120,90,40,.06) 0 1px, transparent 1px 13px),
      radial-gradient(ellipse at 25% 0%, rgba(184,145,47,.05), transparent 55%),
      var(--wood-bg);
  }
  .seal {
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; height: 48px; background: var(--seal); color: #f3e7c6;
    font-family: var(--serif); font-size: 25px; font-weight: 700;
    border: 2px solid #6f2818; border-radius: 3px; transform: rotate(-2.5deg);
    box-shadow: inset 0 0 0 2px rgba(243,231,198,.4);
    user-select: none;
  }
  header {
    padding: 24px 28px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    border-bottom: 3px double var(--wood-line);
    background:
      repeating-linear-gradient(90deg, rgba(0,0,0,.14) 0 3px, transparent 3px 26px),
      var(--wood-panel);
  }
  header h1 { font-family: var(--serif); font-size: 24px; color: var(--paper); letter-spacing: 6px; }
  #badge {
    font-size: 12px; color: var(--cream-dim); letter-spacing: 2px;
    border: 1px solid var(--wood-line); border-radius: 2px; padding: 3px 12px;
  }
  main { max-width: 860px; margin: 0 auto; padding: 24px 24px 70px; }
  #hint {
    font-size: 13px; color: var(--cream-dim); margin: 18px 0 24px; line-height: 2;
    border-left: 3px solid var(--brass-dark); padding-left: 14px; letter-spacing: .5px;
  }
  #hint b { color: var(--brass); }
  .zone { margin-bottom: 32px; }
  .zone h2 {
    font-family: var(--serif); font-size: 18px; color: var(--paper); letter-spacing: 4px;
    margin-bottom: 8px; padding-bottom: 6px;
    border-bottom: 3px double var(--wood-line);
  }
  .zone h2::before { content: "■ "; color: var(--pine); font-size: 12px; vertical-align: 2px; }
  .zone.suspect h2::before { color: var(--amber); }
  .zone .warn { font-size: 12px; color: var(--amber); margin: 4px 0 12px 2px; letter-spacing: 1px; }
  /* ── 条目：宣纸签条 ── */
  .entry {
    display: flex; gap: 12px; align-items: flex-start;
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--paper-line); border-radius: 2px; padding: 13px 16px; margin-bottom: 10px;
    cursor: pointer;
    box-shadow: inset 0 0 0 3px var(--paper), inset 0 0 0 4px var(--paper-hair), 0 2px 0 rgba(0,0,0,.25);
  }
  .entry:hover { background: #f5edda; }
  .entry.picked { outline: 2px solid var(--seal); outline-offset: 1px; }
  .entry input { margin-top: 5px; accent-color: var(--seal); width: 15px; height: 15px; }
  .entry .tag {
    font-family: var(--mono); font-size: 11.5px; font-weight: 700; color: var(--pine);
    border: 1px solid rgba(68,85,63,.5); border-radius: 2px;
    padding: 2px 8px; white-space: nowrap; letter-spacing: .5px;
  }
  .zone.suspect .entry .tag { color: #7c5314; border-color: rgba(150,102,42,.55); }
  .entry .body b { font-size: 15px; font-family: var(--serif); letter-spacing: 1px; }
  .entry .body .sum { font-size: 12.5px; color: var(--ink-dim); margin-top: 4px; line-height: 1.75; }
  /* ── 申请框 ── */
  #applybox {
    background: var(--paper-2); color: var(--ink);
    border: 1px solid var(--paper-line); border-radius: 2px; padding: 20px 22px;
    position: sticky; bottom: 0;
    box-shadow: inset 0 0 0 3px var(--paper-2), inset 0 0 0 4px var(--paper-line), 0 -4px 0 rgba(0,0,0,.3);
  }
  #applybox h3 {
    font-family: var(--serif); font-size: 15px; letter-spacing: 3px; margin-bottom: 12px;
    padding-bottom: 8px; border-bottom: 3px double var(--paper-line);
  }
  #applybox input, #applybox textarea {
    width: 100%; background: #faf3dd; border: 1px solid #bfa97a; color: var(--ink);
    border-radius: 2px; padding: 9px 11px; font-size: 13px; margin-bottom: 10px; font-family: inherit;
  }
  #applybox input:focus, #applybox textarea:focus { outline: 2px solid var(--brass); outline-offset: 0; }
  #applybox textarea { min-height: 64px; resize: vertical; }
  #applybox button {
    background: var(--pine); color: #eef0da;
    border: 1px solid #33402f; border-radius: 2px; padding: 10px 26px; font-size: 14px;
    letter-spacing: 3px; cursor: pointer; font-weight: 600;
  }
  #applybox button:hover { background: #4f6549; }
  #applybox button:disabled { background: #8d8468; color: #5d563f; border-color: #7a7159; cursor: default; }
  #selinfo { font-size: 12px; color: var(--ink-dim); margin-bottom: 10px; letter-spacing: 1px; }
  #msg { font-size: 13px; margin-left: 12px; }
  #msg.ok { color: var(--pine); } #msg.err { color: var(--seal); }
  .closed { text-align: center; padding: 90px 20px; color: var(--cream-dim); letter-spacing: 1px; }
  .closed h2 { color: var(--seal); font-family: var(--serif); letter-spacing: 5px; margin-bottom: 14px; }
</style>
</head>
<body>
<header>
  <span class="seal">知</span>
  <h1>知识库目录</h1>
  <span id="badge">加载中…</span>
</header>
<main>
  <div id="hint">
    勾选需要的知识，填写名称与理由后提交申请。管理员批准后会把你的<b>专属密钥</b>私下转交给你，
    之后即可凭密钥读取对应知识的详细使用方法、使用经验与正文。这里只展示简介，正文不公开。
  </div>
  <div id="zones"></div>
  <div id="applybox">
    <h3>提交访问申请（已勾选 <span id="selcount">0</span> 条）</h3>
    <div id="selinfo">尚未勾选任何知识</div>
    <input id="self_name" maxlength="20" placeholder="你的名称（自报，供管理员识别）">
    <textarea id="reason" maxlength="500" placeholder="申请理由（为什么需要这些知识）"></textarea>
    <button id="submitBtn" onclick="submitApply()" disabled>提交申请</button>
    <span id="msg"></span>
  </div>
</main>
<script>
let catalog = null;
const selected = new Set();

async function load() {
  const zonesEl = document.getElementById('zones');
  const badge = document.getElementById('badge');
  try {
    const r = await fetch('/api/catalog');
    if (r.status === 503) {
      document.querySelector('main').innerHTML =
        '<div class="closed"><h2>服务当前已关闭</h2><p>知识库已被管理员暂停访问，请稍后再试。</p></div>';
      badge.textContent = '已关闭';
      return;
    }
    if (r.status === 403) {
      document.querySelector('main').innerHTML =
        '<div class="closed"><h2>目录暂不公开</h2><p>请联系管理员。</p></div>';
      return;
    }
    const d = await r.json();
    catalog = d;
    let total = 0;
    zonesEl.innerHTML = '';
    for (const z of d.zones) {
      total += z.entries.length;
      const div = document.createElement('div');
      div.className = 'zone' + (z.zone === 'suspect' ? ' suspect' : '');
      let html = '<h2>' + z.label + '（' + z.entries.length + ' 条）</h2>';
      if (z.zone === 'suspect') html += '<div class="warn">⚠ 该区知识未经原理验证，使用时请自行判断风险。</div>';
      if (z.entries.length === 0) html += '<div class="warn">暂无条目</div>';
      div.innerHTML = html;
      for (const e of z.entries) {
        const item = document.createElement('label');
        item.className = 'entry';
        item.innerHTML = '<input type="checkbox" value="' + e.id + '" onchange="onCheck(this)">' +
          '<span class="tag">' + z.label + ' · ' + e.id + '</span>' +
          '<span class="body"><b>' + esc(e.title) + '</b>' +
          '<div class="sum">' + esc(e.summary) + '</div></span>';
        div.appendChild(item);
      }
      zonesEl.appendChild(div);
    }
    badge.textContent = '共 ' + total + ' 条知识';
  } catch (e) {
    document.querySelector('main').innerHTML =
      '<div class="closed"><h2>无法连接服务</h2><p>请确认知识库服务已启动。</p></div>';
  }
}

function esc(s) { const d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }

function onCheck(cb) {
  if (cb.checked) selected.add(cb.value); else selected.delete(cb.value);
  cb.closest('.entry').classList.toggle('picked', cb.checked);
  document.getElementById('selcount').textContent = selected.size;
  document.getElementById('selinfo').textContent = selected.size
    ? '已勾选：' + [...selected].join('、') : '尚未勾选任何知识';
  document.getElementById('submitBtn').disabled = selected.size === 0;
}

async function submitApply() {
  const msg = document.getElementById('msg');
  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  msg.className = ''; msg.textContent = '提交中…';
  try {
    const r = await fetch('/api/apply', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        self_name: document.getElementById('self_name').value,
        reason: document.getElementById('reason').value,
        ids: [...selected]
      })
    });
    const d = await r.json();
    if (r.ok) {
      msg.className = 'ok'; msg.textContent = d.msg || '已提交';
      selected.clear();
      document.querySelectorAll('input[type=checkbox]').forEach(c => { c.checked = false; c.closest('.entry').classList.remove('picked'); });
      onCheck({checked:false});
    } else {
      msg.className = 'err'; msg.textContent = d.detail || '提交失败';
      btn.disabled = selected.size === 0;
    }
  } catch (e) {
    msg.className = 'err'; msg.textContent = '网络错误';
    btn.disabled = selected.size === 0;
  }
}
load();
</script>
</body>
</html>
